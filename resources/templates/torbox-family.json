{
  "metadata": {
    "id": "builtin.torbox-family",
    "name": "TorBox Family",
    "description": "Streams-only family TorBox Pro setup: the same fast, grouped stream sources and 4K-first, English, Fire TV-friendly ranking as TorBox Ultimate. Use AIOMetadata for catalogs (e.g. Netflix Kids, Disney+) and posters, and install Torrentio separately. Includes a compact custom stream formatter for Nuvio and Fire TV.",
    "source": "external",
    "author": "AIOStreams",
    "version": "1.2.1",
    "category": "Debrid",
    "serviceRequired": true,
    "services": ["torbox"]
  },
  "config": {
    "presets": [
      {
        "type": "torbox-search",
        "instanceId": "tbx",
        "enabled": true,
        "options": {
          "name": "TorBox Search",
          "timeout": 7000,
          "sources": ["torrent", "usenet"],
          "mediaTypes": [],
          "userSearchEngines": false,
          "onlyShowUserSearchResults": false,
          "useMultipleInstances": false
        }
      },
      {
        "type": "comet",
        "instanceId": "c9f",
        "enabled": true,
        "options": {
          "name": "Comet",
          "timeout": 7000,
          "resources": ["stream"],
          "includeP2P": false,
          "removeTrash": true,
          "mediaTypes": []
        }
      },
      {
        "type": "stremthruTorz",
        "instanceId": "29d",
        "enabled": true,
        "options": {
          "name": "StremThru Torz",
          "timeout": 7000,
          "resources": ["stream"],
          "mediaTypes": [],
          "includeP2P": false,
          "useMultipleInstances": false
        }
      },
      {
        "type": "mediafusion",
        "instanceId": "224",
        "enabled": true,
        "options": {
          "name": "MediaFusion",
          "timeout": 7000,
          "resources": ["stream"],
          "useCachedResultsOnly": true,
          "enableWatchlistCatalogs": false,
          "downloadViaBrowser": false,
          "contributorStreams": false,
          "certificationLevelsFilter": [],
          "nudityFilter": [],
          "mediaTypes": []
        }
      },
      {
        "type": "torrent-galaxy",
        "instanceId": "7g4",
        "enabled": true,
        "options": {
          "name": "TorrentGalaxy",
          "timeout": 7000,
          "mediaTypes": [],
          "useMultipleInstances": false
        }
      }
    ],
    "formatter": {
      "id": "custom",
      "definitions": {
        "custom": {
          "name": "{service.cached[\"⚡\"||\"⏳\"]} {stream.resolution::exists[\"{stream.resolution::replace('2160p','4K')::replace('1440p','2K')}\"||\"Unknown\"]}{? · {stream.visualTags::join(' · ')}?}",
          "description": "{?🎥 {stream.quality} ?}{?🎞️ {stream.encode} ?}{stream.editions::exists[\"🏆 {stream.editions::join(' · ')} \"||\"\"]}\n{?🔊 {stream.audioTags::join(' · ')} ?}{?{stream.audioChannels::join(' · ')} ?}{stream.languages::string::~English[\"🇬🇧 English\"||\"\"]}{stream.languages::exists::and::stream.languages::string::~English::isfalse[\"🗣️ {stream.languageEmojis::join(' ')}\"||\"\"]}\n{stream.bitrate::>0[\"📊 {stream.bitrate::sbitrate} \"||\"\"]}{?🏷️ {stream.releaseGroup}?}\n{service.cached[\"⚡ Instant\"||\"⏳ Needs download\"]}{service.id::exists[\" · {service.shortName}\"||\"\"]}{stream.type::=usenet[\" · 📰 Usenet\"||\"\"]}{stream.library[\" · 📌 In your TorBox\"||\"\"]} · {addon.name}\n{?ℹ️ {stream.message}?}"
        }
      },
      "definition": {
        "name": "{service.cached[\"⚡\"||\"⏳\"]} {stream.resolution::exists[\"{stream.resolution::replace('2160p','4K')::replace('1440p','2K')}\"||\"Unknown\"]}{? · {stream.visualTags::join(' · ')}?}",
        "description": "{?🎥 {stream.quality} ?}{?🎞️ {stream.encode} ?}{stream.editions::exists[\"🏆 {stream.editions::join(' · ')} \"||\"\"]}\n{?🔊 {stream.audioTags::join(' · ')} ?}{?{stream.audioChannels::join(' · ')} ?}{stream.languages::string::~English[\"🇬🇧 English\"||\"\"]}{stream.languages::exists::and::stream.languages::string::~English::isfalse[\"🗣️ {stream.languageEmojis::join(' ')}\"||\"\"]}\n{stream.bitrate::>0[\"📊 {stream.bitrate::sbitrate} \"||\"\"]}{?🏷️ {stream.releaseGroup}?}\n{service.cached[\"⚡ Instant\"||\"⏳ Needs download\"]}{service.id::exists[\" · {service.shortName}\"||\"\"]}{stream.type::=usenet[\" · 📰 Usenet\"||\"\"]}{stream.library[\" · 📌 In your TorBox\"||\"\"]} · {addon.name}\n{?ℹ️ {stream.message}?}"
      }
    },
    "preferredQualities": [
      "BluRay",
      "WEB-DL",
      "BluRay REMUX",
      "WEBRip",
      "HDRip",
      "HC HD-Rip",
      "DVDRip",
      "HDTV",
      "CAM",
      "TS",
      "TC",
      "SCR",
      "Unknown"
    ],
    "preferredResolutions": [
      "2160p",
      "1440p",
      "1080p",
      "720p",
      "576p",
      "480p",
      "360p",
      "240p",
      "144p",
      "Unknown"
    ],
    "excludedQualities": ["CAM", "SCR", "TS", "TC"],
    "excludedVisualTags": ["3D", "H-OU", "H-SBS", "AI"],
    "sortCriteria": {
      "global": [
        {
          "key": "cached",
          "direction": "desc"
        },
        {
          "key": "library",
          "direction": "desc"
        },
        {
          "key": "resolution",
          "direction": "desc"
        },
        {
          "key": "regexPatterns",
          "direction": "desc"
        },
        {
          "key": "streamExpressionMatched",
          "direction": "desc"
        },
        {
          "key": "quality",
          "direction": "desc"
        },
        {
          "key": "visualTag",
          "direction": "desc"
        },
        {
          "key": "audioTag",
          "direction": "desc"
        },
        {
          "key": "audioChannel",
          "direction": "desc"
        },
        {
          "key": "encode",
          "direction": "desc"
        },
        {
          "key": "language",
          "direction": "desc"
        },
        {
          "key": "size",
          "direction": "desc"
        }
      ]
    },
    "deduplicator": {
      "enabled": true,
      "multiGroupBehaviour": "aggressive",
      "keys": ["filename", "infoHash"],
      "cached": "single_result",
      "uncached": "per_service",
      "p2p": "single_result"
    },
    "excludedResolutions": ["360p", "240p", "144p"],
    "includedResolutions": [],
    "requiredResolutions": [],
    "includedQualities": [],
    "requiredQualities": [],
    "excludedLanguages": [],
    "includedLanguages": [],
    "requiredLanguages": ["English", "Multi", "Dual Audio", "Unknown"],
    "preferredLanguages": ["English", "Multi", "Dual Audio", "Unknown"],
    "includedVisualTags": [],
    "requiredVisualTags": [],
    "preferredVisualTags": [
      "HDR+DV",
      "DV",
      "HDR10+",
      "HDR10",
      "HDR",
      "10bit",
      "IMAX",
      "SDR",
      "Unknown"
    ],
    "excludedAudioTags": [],
    "includedAudioTags": [],
    "requiredAudioTags": [],
    "preferredAudioTags": [
      "DD+",
      "DD",
      "Atmos",
      "DTS",
      "TrueHD",
      "DTS-HD MA",
      "DTS:X",
      "DTS-HD",
      "DTS-ES",
      "AAC",
      "FLAC",
      "OPUS",
      "Unknown"
    ],
    "excludedStreamTypes": [],
    "includedStreamTypes": [],
    "requiredStreamTypes": [],
    "preferredStreamTypes": [],
    "excludedEncodes": ["XviD", "DivX"],
    "includedEncodes": [],
    "requiredEncodes": [],
    "preferredEncodes": ["HEVC", "AVC", "Unknown", "AV1"],
    "seederRangeTypes": [],
    "digitalReleaseFilter": {
      "enabled": true,
      "tolerance": 0,
      "requestTypes": [],
      "addons": []
    },
    "excludeCachedFromAddons": [],
    "excludeCachedFromServices": [],
    "excludeCachedFromStreamTypes": [],
    "excludeUncachedFromAddons": [],
    "excludeUncachedFromServices": [],
    "excludeUncachedFromStreamTypes": [],
    "proxy": {
      "proxiedAddons": [],
      "proxiedServices": [],
      "id": "builtin"
    },
    "hideErrorsForResources": [],
    "statistics": {
      "enabled": true,
      "position": "bottom",
      "statsToShow": ["addon", "filter"]
    },
    "tmdbApiKey": "<template_placeholder>",
    "yearMatching": {
      "enabled": true,
      "requestTypes": [],
      "addons": []
    },
    "titleMatching": {
      "similarityThreshold": 1,
      "enabled": true,
      "requestTypes": ["movie", "series"],
      "addons": []
    },
    "seasonEpisodeMatching": {
      "enabled": true,
      "requestTypes": ["movie", "series"],
      "addons": []
    },
    "autoPlay": {
      "attributes": [
        "service",
        "proxied",
        "resolution",
        "quality",
        "encode",
        "audioTags",
        "visualTags",
        "languages",
        "releaseGroup"
      ]
    },
    "catalogModifications": [],
    "cacheAndPlay": {
      "enabled": true,
      "streamTypes": ["usenet"]
    },
    "excludedStreamExpressions": [
      "queryType == 'movie' ? size(streams, 0, '200MB') : []"
    ],
    "resultLimits": {
      "resolution": 8,
      "global": 40
    },
    "groups": {
      "enabled": true,
      "behaviour": "sequential",
      "groupings": [
        {
          "addons": ["tbx", "c9f"],
          "condition": "true"
        },
        {
          "addons": ["29d", "224", "7g4"],
          "condition": "count(cached(totalStreams)) < 5"
        }
      ]
    }
  }
}
