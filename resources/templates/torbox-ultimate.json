{
  "metadata": {
    "id": "builtin.torbox-ultimate",
    "name": "TorBox Ultimate",
    "description": "Streams-only TorBox Pro setup for Fire TV: TorBox Search (torrent + usenet) and Comet first, with StremThru Torz, MediaFusion and TorrentGalaxy asked only when fewer than 5 instant results are found. 4K first, English, Dolby Vision/HDR and Fire TV-friendly Dolby audio preferred, junk filtered. Use AIOMetadata for catalogs and posters, and install Torrentio separately.",
    "source": "external",
    "author": "AIOStreams",
    "version": "2.0.0",
    "category": "Debrid",
    "serviceRequired": true,
    "services": ["torbox"]
  },
  "config": {
    "presets": [
      {
        "type": "torbox-search",
        "instanceId": "tbx",
        "enabled": true,
        "options": {
          "name": "TorBox Search",
          "timeout": 7000,
          "sources": ["torrent", "usenet"],
          "mediaTypes": [],
          "userSearchEngines": false,
          "onlyShowUserSearchResults": false,
          "useMultipleInstances": false
        }
      },
      {
        "type": "comet",
        "instanceId": "c9f",
        "enabled": true,
        "options": {
          "name": "Comet",
          "timeout": 7000,
          "resources": ["stream"],
          "includeP2P": false,
          "removeTrash": true,
          "mediaTypes": []
        }
      },
      {
        "type": "stremthruTorz",
        "instanceId": "29d",
        "enabled": true,
        "options": {
          "name": "StremThru Torz",
          "timeout": 7000,
          "resources": ["stream"],
          "mediaTypes": [],
          "includeP2P": false,
          "useMultipleInstances": false
        }
      },
      {
        "type": "mediafusion",
        "instanceId": "224",
        "enabled": true,
        "options": {
          "name": "MediaFusion",
          "timeout": 7000,
          "resources": ["stream"],
          "useCachedResultsOnly": true,
          "enableWatchlistCatalogs": false,
          "downloadViaBrowser": false,
          "contributorStreams": false,
          "certificationLevelsFilter": [],
          "nudityFilter": [],
          "mediaTypes": []
        }
      },
      {
        "type": "torrent-galaxy",
        "instanceId": "7g4",
        "enabled": true,
        "options": {
          "name": "TorrentGalaxy",
          "timeout": 7000,
          "mediaTypes": [],
          "useMultipleInstances": false
        }
      }
    ],
    "formatter": {
      "id": "prism",
      "definition": {
        "name": "",
        "description": ""
      }
    },
    "preferredQualities": [
      "BluRay",
      "WEB-DL",
      "BluRay REMUX",
      "WEBRip",
      "HDRip",
      "HC HD-Rip",
      "DVDRip",
      "HDTV",
      "CAM",
      "TS",
      "TC",
      "SCR",
      "Unknown"
    ],
    "preferredResolutions": [
      "2160p",
      "1440p",
      "1080p",
      "720p",
      "576p",
      "480p",
      "360p",
      "240p",
      "144p",
      "Unknown"
    ],
    "excludedQualities": ["CAM", "SCR", "TS", "TC"],
    "excludedVisualTags": ["3D", "H-OU", "H-SBS", "AI"],
    "sortCriteria": {
      "global": [
        {
          "key": "cached",
          "direction": "desc"
        },
        {
          "key": "library",
          "direction": "desc"
        },
        {
          "key": "resolution",
          "direction": "desc"
        },
        {
          "key": "regexPatterns",
          "direction": "desc"
        },
        {
          "key": "streamExpressionMatched",
          "direction": "desc"
        },
        {
          "key": "quality",
          "direction": "desc"
        },
        {
          "key": "visualTag",
          "direction": "desc"
        },
        {
          "key": "audioTag",
          "direction": "desc"
        },
        {
          "key": "audioChannel",
          "direction": "desc"
        },
        {
          "key": "encode",
          "direction": "desc"
        },
        {
          "key": "language",
          "direction": "desc"
        },
        {
          "key": "size",
          "direction": "desc"
        }
      ]
    },
    "deduplicator": {
      "enabled": true,
      "multiGroupBehaviour": "aggressive",
      "keys": ["filename", "infoHash"],
      "cached": "single_result",
      "uncached": "per_service",
      "p2p": "single_result"
    },
    "excludedResolutions": ["360p", "240p", "144p"],
    "includedResolutions": [],
    "requiredResolutions": [],
    "includedQualities": [],
    "requiredQualities": [],
    "excludedLanguages": [],
    "includedLanguages": [],
    "requiredLanguages": ["English", "Multi", "Dual Audio", "Unknown"],
    "preferredLanguages": ["English", "Multi", "Dual Audio", "Unknown"],
    "includedVisualTags": [],
    "requiredVisualTags": [],
    "preferredVisualTags": [
      "HDR+DV",
      "DV",
      "HDR10+",
      "HDR10",
      "HDR",
      "10bit",
      "IMAX",
      "SDR",
      "Unknown"
    ],
    "excludedAudioTags": [],
    "includedAudioTags": [],
    "requiredAudioTags": [],
    "preferredAudioTags": [
      "DD+",
      "DD",
      "Atmos",
      "DTS",
      "TrueHD",
      "DTS-HD MA",
      "DTS:X",
      "DTS-HD",
      "DTS-ES",
      "AAC",
      "FLAC",
      "OPUS",
      "Unknown"
    ],
    "excludedStreamTypes": [],
    "includedStreamTypes": [],
    "requiredStreamTypes": [],
    "preferredStreamTypes": [],
    "excludedEncodes": ["XviD", "DivX"],
    "includedEncodes": [],
    "requiredEncodes": [],
    "preferredEncodes": ["HEVC", "AVC", "Unknown", "AV1"],
    "seederRangeTypes": [],
    "digitalReleaseFilter": {
      "enabled": true,
      "tolerance": 0,
      "requestTypes": [],
      "addons": []
    },
    "excludeCachedFromAddons": [],
    "excludeCachedFromServices": [],
    "excludeCachedFromStreamTypes": [],
    "excludeUncachedFromAddons": [],
    "excludeUncachedFromServices": [],
    "excludeUncachedFromStreamTypes": [],
    "proxy": {
      "proxiedAddons": [],
      "proxiedServices": [],
      "id": "builtin"
    },
    "hideErrorsForResources": [],
    "statistics": {
      "enabled": true,
      "position": "bottom",
      "statsToShow": ["addon", "filter"]
    },
    "tmdbApiKey": "<template_placeholder>",
    "yearMatching": {
      "enabled": true,
      "requestTypes": [],
      "addons": []
    },
    "titleMatching": {
      "similarityThreshold": 1,
      "enabled": true,
      "requestTypes": ["movie", "series"],
      "addons": []
    },
    "seasonEpisodeMatching": {
      "enabled": true,
      "requestTypes": ["movie", "series"],
      "addons": []
    },
    "autoPlay": {
      "attributes": [
        "service",
        "proxied",
        "resolution",
        "quality",
        "encode",
        "audioTags",
        "visualTags",
        "languages",
        "releaseGroup"
      ]
    },
    "catalogModifications": [],
    "cacheAndPlay": {
      "enabled": true,
      "streamTypes": ["usenet"]
    },
    "excludedStreamExpressions": [
      "queryType == 'movie' ? size(streams, 0, '200MB') : []"
    ],
    "resultLimits": {
      "resolution": 8,
      "global": 40
    },
    "groups": {
      "enabled": true,
      "behaviour": "sequential",
      "groupings": [
        {
          "addons": ["tbx", "c9f"],
          "condition": "true"
        },
        {
          "addons": ["29d", "224", "7g4"],
          "condition": "count(cached(totalStreams)) < 5"
        }
      ]
    }
  }
}
